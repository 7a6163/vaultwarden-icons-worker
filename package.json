{
  "name": "vaultwarden-icons",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare Worker that resolves and serves website favicons for Vaultwarden, hiding the server's egress IP from target sites.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.13",
    "@cloudflare/workers-types": "^4.20260613.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-istanbul": "~3.2.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.9.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.42.0"
  }
}
